@startuml
hide circle
skinparam linetype ortho
 
entity "User" as user {
  id : TEXT <<PK>>
  --
  email : TEXT <<unique>>
  password : TEXT
  role : TEXT (ADMIN, USER)
  status : TEXT (PENDING, ACTIVE)
  ntfyTopic : TEXT
  name, image, createdAt
}
 
entity "Account" as account {
  id : TEXT <<PK>>
  --
  userId : TEXT <<FK>>
  provider, providerAccountId
  [OAuth token fields]
}
 
entity "Session" as session {
  id : TEXT <<PK>>
  --
  sessionToken : TEXT <<unique>>
  userId : TEXT <<FK>>
  expires : DATETIME
}
 
entity "Category" as cat {
  id : TEXT <<PK>>
  --
  userId : TEXT <<FK>>
  name : TEXT
  type : TEXT (INCOME, EXPENSE)
  icon : TEXT
  order : INT
}
 
entity "CapitalCategory" as capcat {
  id : TEXT <<PK>>
  --
  userId : TEXT <<FK>>
  name : TEXT
  icon : TEXT
  color : TEXT
  moneyType : TEXT (CASH, BANK)
  order : INT
}

entity "MonthlySheet" as sheet {
  id : TEXT <<PK>>
  --
  userId : TEXT <<FK>>
  month : INT
  year : INT
}
 
entity "Transaction" as trans {
  id : TEXT <<PK>>
  --
  monthlySheetId : TEXT <<FK>>
  categoryId : TEXT <<FK>>
  amount : FLOAT
  type : TEXT (INCOME, EXPENSE)
  description : TEXT
  date : DATETIME
  isRecurring : BOOLEAN
  recurringIntervalMonths : INT
  paymentMethod : TEXT (CASH, BANK)
  splitMonths : INT
  splitIndex : INT
  splitGroupId : TEXT
}
 
entity "Capital" as capital {
  id : TEXT <<PK>>
  --
  monthlySheetId : TEXT <<FK>>
  capitalCategoryId : TEXT <<FK>>
  amount : FLOAT
  order : INT
}
 
entity "SharedAccess" as sharing {
  id : TEXT <<PK>>
  --
  ownerId : TEXT <<FK>>
  sharedWithId : TEXT <<FK>>
  permission : TEXT (VIEW, EDIT)
}
 
entity "Apartment" as apt {
  id : TEXT <<PK>>
  --
  name : TEXT
  createdAt, updatedAt
}

entity "ApartmentMember" as aptmem {
  id : TEXT <<PK>>
  --
  apartmentId : TEXT <<FK>>
  userId : TEXT <<FK>>
  role : TEXT (OWNER, MEMBER)
  <<unique: apartmentId + userId>>
}

entity "ApartmentInvite" as aptinv {
  id : TEXT <<PK>>
  --
  apartmentId : TEXT <<FK>>
  invitedById : TEXT <<FK>>
  email : TEXT
  status : TEXT (PENDING, ACCEPTED, DECLINED)
  <<unique: apartmentId + email>>
}

entity "HousingCategory" as houscat {
  id : TEXT <<PK>>
  --
  apartmentId : TEXT <<FK>>
  name : TEXT
  unit : TEXT (EUR, M3, KWH)
  icon : TEXT
  color : TEXT
  order : INT
  <<unique: apartmentId + name>>
}

entity "HousingMonth" as housmon {
  id : TEXT <<PK>>
  --
  apartmentId : TEXT <<FK>>
  month : INT
  year : INT
  <<unique: apartmentId + month + year>>
}

entity "HousingEntry" as housent {
  id : TEXT <<PK>>
  --
  housingMonthId : TEXT <<FK>>
  housingCategoryId : TEXT <<FK>>
  amount : FLOAT (EUR)
  quantity : FLOAT (m3 / kWh)
  note : TEXT
  <<unique: housingMonthId + housingCategoryId>>
}
 
user ||--o{ account : ""
user ||--o{ session : ""
user ||--o{ sheet : "owns"
user ||--o{ cat : "creates"
user ||--o{ capcat : "creates"
user ||--o{ sharing : "grants"
user ||--o{ sharing : "receives"
sheet ||--o{ trans : "contains"
sheet ||--o{ capital : "tracks"
cat ||--o{ trans : "classifies"
capcat ||--o{ capital : "categorizes"
user ||--o{ aptmem : "belongs to"
user ||--o{ aptinv : "sends"
apt ||--o{ aptmem : "has members"
apt ||--o{ aptinv : "has invites"
apt ||--o{ houscat : "defines"
apt ||--o{ housmon : "records"
housmon ||--o{ housent : "contains"
houscat ||--o{ housent : "classifies"
 
@enduml