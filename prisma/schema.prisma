generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String?
  emailVerified DateTime?      // needed for Auth.js
  image         String?
  role          String         @default("USER")
  status        String         @default("PENDING")
  ntfyTopic     String?        // ntfy.sh topic for money-tracker reminder pushes (scripts/send-reminders.ts)

  accounts      Account[]
  sessions      Session[]
  sheets        MonthlySheet[]
  categories    Category[]
  capitalCategories  CapitalCategory[]
  sharedWithMe  SharedAccess[] @relation("SharedToUser")
  myShares      SharedAccess[] @relation("SharedFromUser")
  apartments        ApartmentMember[]
  apartmentInvites  ApartmentInvite[] @relation("ApartmentInvitesSent")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model Category {
  id            String        @id @default(cuid())
  name          String
  type          String
  icon          String?
  order         Int?          @default(0)
  userId        String
  createdAt     DateTime      @default(now()) 
  updatedAt     DateTime      @default(now()) @updatedAt
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]

  @@unique([userId, type, name])
}

model MonthlySheet {
  id            String        @id @default(cuid())
  month         Int
  year          Int
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactions  Transaction[]
  capitals      Capital[]

  createdAt     DateTime      @default(now())
  
  @@unique([month, year, userId]) // Does not allow multiple sheets for the same month and year for a user
  @@index([userId, year, month])
}

model Transaction {
  id             String       @id @default(cuid())
  amount         Float
  description    String?
  date           DateTime     @default(now())
  type           String
  createdAt      DateTime     @default(now())

  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  monthlySheetId String
  monthlySheet   MonthlySheet @relation(fields: [monthlySheetId], references: [id], onDelete: Cascade)

  isRecurring    Boolean      @default(false)
  recurringIntervalMonths Int? // months between repeats when isRecurring; null/1 = every month

  paymentMethod  String       @default("BANK") // CASH or BANK - drives the cash/bank expected-vs-actual breakdown

  splitMonths    Int?         // total parts (null = not a split)
  splitIndex     Int?         // which part
  splitGroupId   String?      // links all parts of one split together

  @@index([monthlySheetId])
  @@index([categoryId])
  @@index([splitGroupId])
}

model Capital {
  id                 String          @id @default(cuid())
  amount             Float
  order              Int?            @default(0)
  monthlySheetId     String
  monthlySheet       MonthlySheet    @relation(fields: [monthlySheetId], references: [id], onDelete: Cascade)
  capitalCategoryId  String
  capitalCategory    CapitalCategory @relation(fields: [capitalCategoryId], references: [id], onDelete: Cascade)

  @@index([monthlySheetId])
  @@index([capitalCategoryId])
}

model CapitalCategory {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  color     String    @default("#64748B")
  moneyType String?   // CASH or BANK - which cash/bank bucket this category counts toward, if any
  order     Int?      @default(0)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capitals  Capital[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([userId, name])
}

model SharedAccess {
  id             String   @id @default(cuid())
  
  // Who shares
  ownerId        String
  owner          User     @relation("SharedFromUser", fields: [ownerId], references: [id])
  
  // Who is shared to
  sharedWithId   String
  sharedWith     User     @relation("SharedToUser", fields: [sharedWithId], references: [id])
  
  permission  String  @default("VIEW") // VIEW or EDIT

  createdAt      DateTime @default(now())

  @@unique([ownerId, sharedWithId])
  @@index([sharedWithId])
}

/// A shared household. Housing costs hang off the apartment rather than off a
/// MonthlySheet, because two people living together need one set of numbers
/// that neither of them "owns" - see ApartmentMember.
model Apartment {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  members    ApartmentMember[]
  invites    ApartmentInvite[]
  categories HousingCategory[]
  months     HousingMonth[]
}

/// Membership is the only authorization check for anything housing-related.
/// Deliberately not SharedAccess: that model is one-directional (owner grants a
/// guest a view of *their* data) and grants access to every sheet at once.
model ApartmentMember {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER (can invite/remove) or MEMBER
  createdAt   DateTime  @default(now())

  @@unique([apartmentId, userId])
  @@index([userId])
}

/// Invite by email so it can be sent before the invitee has an account. It sits
/// PENDING until they register, are approved by an admin, and accept it.
model ApartmentInvite {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  email       String    // stored lowercased; matched against User.email on accept
  status      String    @default("PENDING") // PENDING, ACCEPTED or DECLINED
  invitedById String
  invitedBy   User      @relation("ApartmentInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([apartmentId, email])
  @@index([email, status])
  @@index([invitedById])
}

/// One cost line of the household: rent, parking, electricity, ... Owned by the
/// apartment, so both members see and edit the same list.
model HousingCategory {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name        String
  unit        String    @default("EUR") // EUR, M3 (m³ of water) or KWH
  icon        String?
  color       String    @default("#64748B")
  order       Int?      @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  entries     HousingEntry[]

  @@unique([apartmentId, name])
}

model HousingMonth {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  createdAt   DateTime  @default(now())

  entries     HousingEntry[]

  @@unique([apartmentId, month, year])
  @@index([apartmentId, year, month])
}

/// One category's figures for one month. `amount` is always euros and is what
/// the month total sums; `quantity` carries the m³/kWh reading alongside it for
/// metered categories and is never added to money.
model HousingEntry {
  id                String          @id @default(cuid())
  housingMonthId    String
  housingMonth      HousingMonth    @relation(fields: [housingMonthId], references: [id], onDelete: Cascade)
  housingCategoryId String
  housingCategory   HousingCategory @relation(fields: [housingCategoryId], references: [id], onDelete: Cascade)

  amount            Float?          // euros paid; null while not filled in
  quantity          Float?          // m³ or kWh consumed this month; metered categories only
  note              String?
  updatedAt         DateTime        @default(now()) @updatedAt

  @@unique([housingMonthId, housingCategoryId])
  @@index([housingCategoryId])
}
